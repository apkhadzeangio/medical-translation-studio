DATABASE_URL=postgresql://mts:mts@localhost:5432/mts
ENVIRONMENT=development
STORAGE_DIR=./data
MAX_UPLOAD_MB=500
EMBEDDED_WORKER=false   # true = run the job worker inside the API process (single-service deploy)
# Shared token for /api/* until real auth (PR-12). Leave empty locally; set it on Railway.
API_TOKEN=

# LLM gateway (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEYS=            # one key, or several comma-separated
LLM_MODEL=gpt-6-astra
LLM_PRICES={"gpt-6-astra": {"input": 10, "cached_input": 1, "output": 50}}
LLM_BUDGET_USD=          # optional hard cap across all projects
LLM_REVIEW_MODEL=        # medical review; empty = LLM_MODEL
LLM_QA_MODEL=            # independent QA; empty = skip the model QA stage. Prefer another vendor's model
LLM_QA_BASE_URL=         # only if the QA model is at a different endpoint
LLM_QA_API_KEYS=
